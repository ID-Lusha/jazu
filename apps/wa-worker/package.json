{
  "name": "@jazu/wa-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file=../../.env --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@jazu/observability": "workspace:*",
    "@jazu/queue": "workspace:*",
    "@whiskeysockets/baileys": "7.0.0-rc13",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
