{
  "name": "@jazu/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --env-file=../../.env --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@jazu/ai": "workspace:*",
    "@jazu/db": "workspace:*",
    "@jazu/observability": "workspace:*",
    "@jazu/queue": "workspace:*",
    "@jazu/shared": "workspace:*",
    "@jazu/wa-pipeline": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
