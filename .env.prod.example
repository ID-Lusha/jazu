# ============================================================================
# Jazu — production env (для docker-compose.prod.yml).
# Скопируйте: cp .env.prod.example .env (или .env.prod, как удобнее) и заполните.
#
# ВАЖНО: .env закоммитить НЕЛЬЗЯ. Это файл секретов.
# ============================================================================

# ── Домены ─────────────────────────────────────────────────────────────────
WEB_DOMAIN=app.jazu.io
API_DOMAIN=api.jazu.io
WEB_ORIGIN=https://app.jazu.io
API_ORIGIN=https://api.jazu.io
# NEXT_PUBLIC_* зашивается в JS-бандл на этапе docker build.
# Если меняете API_DOMAIN — пересоберите образ web!
NEXT_PUBLIC_API_BASE_URL=https://api.jazu.io/api

# ── Let's Encrypt ──────────────────────────────────────────────────────────
# Email для уведомлений об истечении сертификатов.
ACME_EMAIL=admin@jazu.io

# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_USER=jazu
POSTGRES_DB=jazu
# Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_use_openssl_rand_hex_24

# ── Секреты приложения (все ОБЯЗАТЕЛЬНЫ) ───────────────────────────────────
# openssl rand -hex 32
MAGIC_LINK_SECRET=CHANGE_ME_use_openssl_rand_hex_32
API_INTERNAL_TOKEN=CHANGE_ME_use_openssl_rand_hex_32

# ── OpenAI ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1

# ── Email (Resend) — для magic link ────────────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@jazu.io

# ── Google OAuth (опционально) ─────────────────────────────────────────────
# Чтобы появилась кнопка "Войти через Google" — задайте все три.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.jazu.io/api/auth/google/callback

# ── Telegram lead-notifications (опционально) ──────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── Очереди / производительность (BullMQ) ─────────────────────────────────
# Параллельность одного контейнера jobs-worker (по умолчанию 10).
# Для боевой нагрузки лучше масштабироваться репликами, а не задиранием числа.
JOBS_CONCURRENCY=10
# WhatsApp outbound: concurrency в wa-worker и интервал per-chatId в мс.
WA_OUTBOUND_CONCURRENCY=8
WA_PER_CHAT_MIN_INTERVAL_MS=1200

# ── Docker image теги (для CI/CD; локально можно не трогать) ──────────────
JAZU_API_IMAGE=jazu-api:latest
JAZU_WEB_IMAGE=jazu-web:latest
JAZU_WA_WORKER_IMAGE=jazu-wa-worker:latest
JAZU_JOBS_IMAGE=jazu-jobs:latest
